# Copy to .env (Git-ignored) and fill in your own values. Never commit .env.

# FlightAware AeroAPI (Personal tier works): flight research and gates
AEROAPI_KEY=

# SimBrief: your numeric pilot ID (Account Settings) or your alias
SIMBRIEF_USERID=
# SIMBRIEF_ALIAS=

# Browserbase: cloud browser that fills SimBrief's dispatch form.
# `uv run ifd-simbrief` saves BROWSERBASE_SIMBRIEF_CONTEXT_ID after you log in once.
BROWSERBASE_API_KEY=
# BROWSERBASE_SIMBRIEF_CONTEXT_ID=

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=infinite-flight-agent
# LANGSMITH_TRACING=true

# Optional: Postgres instead of local SQLite (needed for the remote server)
# DATABASE_URL=

# Remote server only (see docs/implementation/deployment.md)
# IFD_CREDENTIAL_KEY=
# IFD_INTERNAL_TOKEN=
# IFD_PAID_OPERATIONS_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
